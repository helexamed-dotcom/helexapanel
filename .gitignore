config/config.php

# Written by install.php on the machine it ran on; it is per-installation
# state, not source, and committing it would make a fresh clone claim to be
# already installed.
storage/installed.lock
storage/sessions/sess_*
storage/logs/*.log
storage/cache/*

# Release archives are built from a commit, so committing one back would
# duplicate the whole tree and be stale the moment anything changes.
*.zip

# Files people upload (lesson images, receipts, product photos, …) are data,
# not source.
storage/private/uploads/*
!storage/private/uploads/.gitkeep
