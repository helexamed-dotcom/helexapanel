<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark, as a vector.

  It is the same "H" the website draws in its sidebar and on its sign-in card,
  so the icon on the home screen and the logo in the app are one thing. Vector
  rather than a set of PNGs: it stays sharp on every density, and an adaptive
  icon gets masked to whatever shape the launcher uses.

  Drawn inside the inner 72x72 of the 108x108 canvas — anything outside that is
  cropped by the mask on a round or squircle launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left stem -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,34 h9 v40 h-9 z" />
    <!-- Right stem -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M61,34 h9 v40 h-9 z" />
    <!-- Crossbar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,49 h32 v10 h-32 z" />
</vector>
