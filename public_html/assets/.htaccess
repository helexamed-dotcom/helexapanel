# Static assets only. PHP must never execute from this directory,
# which neutralises an upload that somehow lands here.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .phar

<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
